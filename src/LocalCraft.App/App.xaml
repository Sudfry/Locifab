<Application x:Class="LocalCraft.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LocalCraft.App.Converters"
             xmlns:views="clr-namespace:LocalCraft.App.Views"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />

            <DataTemplate DataType="{x:Type vm:RenameViewModel}">
                <views:RenameView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ToolboxViewModel}">
                <views:ToolboxView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConvertViewModel}">
                <views:ConvertView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TextReplaceViewModel}">
                <views:TextReplaceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DedupViewModel}">
                <views:DedupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupViewModel}">
                <views:BackupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WatchViewModel}">
                <views:WatchView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TableViewModel}">
                <views:TableView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ArchiveViewModel}">
                <views:ArchiveView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
                <views:CleanupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChecksumViewModel}">
                <views:ChecksumView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ImageBatchViewModel}">
                <views:ImageBatchView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PhotoDedupViewModel}">
                <views:PhotoDedupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MetadataViewModel}">
                <views:MetadataView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SearchViewModel}">
                <views:SearchView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportViewModel}">
                <views:ReportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PipelineViewModel}">
                <views:PipelineView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SplitMergeViewModel}">
                <views:SplitMergeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FileStateViewModel}">
                <views:FileStateView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TemplateViewModel}">
                <views:TemplateView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiffViewModel}">
                <views:DiffView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ClassifyViewModel}">
                <views:ClassifyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EnvironmentViewModel}">
                <views:EnvironmentView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LinksViewModel}">
                <views:LinksView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OnlineViewModel}">
                <views:OnlineView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GuideViewModel}">
                <views:GuideView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UndoCenterViewModel}">
                <views:UndoCenterView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <views:PlaceholderView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
