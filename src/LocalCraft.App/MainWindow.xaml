<Window x:Class="LocalCraft.App.MainWindow"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Locifab 11.0.3 · 本地文件工坊"
        Width="1320" Height="820"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Subtitle}" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                    <Condition Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </MultiDataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                    <Condition Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="NavBorder" Property="Background" Value="{Binding CategoryHighlightBrush}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Margin="2,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="{DynamicResource BorderStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="2,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Margin="2,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="{DynamicResource DangerBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="{DynamicResource DangerBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="NavContextMenu">
            <MenuItem Header="添加到首页常用功能" Click="AddFavorite_Click" />
        </ContextMenu>

        <DataTemplate x:Key="NavItemTemplate">
            <Grid x:Name="NavGrid" Height="{DynamicResource NavRowHeight}"
                  AutomationProperties.Name="{Binding Title}"
                  AutomationProperties.HelpText="{Binding Subtitle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="HoverLayer"
                        Grid.ColumnSpan="4"
                        CornerRadius="9"
                        Background="Transparent"
                        IsHitTestVisible="False" />

                <Border x:Name="CollapsedIconLayer"
                        Grid.ColumnSpan="4"
                        Width="42" Height="42"
                        CornerRadius="12"
                        Background="{Binding CategorySoftBrush}"
                        Margin="-4,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Path x:Name="CollapsedIconPath" Data="{Binding IconData}"
                          Width="21" Height="21"
                          Stretch="Uniform"
                          Stroke="{Binding CategoryBrush}"
                          StrokeThickness="1.6"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <Border x:Name="NavAccent" Width="3" Height="20" CornerRadius="2"
                        Background="{Binding CategoryBrush}"
                        VerticalAlignment="Center" />

                <Border x:Name="IconBox"
                        Grid.Column="1"
                        Width="30" Height="30"
                        CornerRadius="8"
                        Background="{Binding CategorySoftBrush}"
                        VerticalAlignment="Center">
                    <Path x:Name="NavIcon"
                          Data="{Binding IconData}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Stroke="{Binding CategoryBrush}"
                          StrokeThickness="1.6"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" Margin="10,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NavTitle"
                               Text="{Binding Title}"
                               FontSize="{Binding DataContext.SidebarFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SidebarTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NavSubtitle"
                               Text="{Binding Subtitle}"
                               FontSize="9.5"
                               Margin="0,1,0,0"
                               Foreground="{DynamicResource SidebarMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border x:Name="NavBadge"
                        Grid.Column="3"
                        Background="{Binding CategorySoftBrush}"
                        CornerRadius="5"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Visibility="{Binding DataContext.ShowSidebarBadges, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Badge}"
                               FontSize="8.5"
                               Foreground="{Binding CategoryBrush}" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="HoverLayer" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="HoverLayer" Property="Background" Value="Transparent" />
                    <Setter TargetName="NavTitle" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NavSubtitle" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NavBadge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NavAccent" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CollapsedIconLayer" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NavGrid" Property="Height" Value="48" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="CollapsedIconLayer" Property="Background" Value="{Binding CategoryHighlightBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="CollapsedIconLayer" Property="Background" Value="{Binding CategoryBrush}" />
                    <Setter TargetName="CollapsedIconPath" Property="Stroke" Value="#FFFFFF" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="IconBox" Property="Background" Value="{Binding CategoryBrush}" />
                    <Setter TargetName="IconBox" Property="Opacity" Value="1" />
                    <Setter TargetName="NavIcon" Property="Stroke" Value="#FFFFFF" />
                    <Setter TargetName="NavTitle" Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}" />
                    <Setter TargetName="NavSubtitle" Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}" />
                    <Setter TargetName="NavBadge" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="NavBadge" Property="Opacity" Value="0.95" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidthGrid}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="84" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="14,0,10,0"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0" />
                                    <GradientStop Color="#8B5CF6" Offset="0.55" />
                                    <GradientStop Color="#F59E0B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Viewbox Margin="8">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 3.5,5 H 10 L 12,7 H 19.5 V 19.5 H 3.5 Z"
                                          Fill="#FFFFFF" Opacity="0.45" />
                                    <Path Data="M 7,3.5 H 14 L 20.5,10 V 20.5 H 7 Z"
                                          Fill="#FFFFFF" Opacity="0.95" />
                                    <Path Data="M 14,3.5 V 10 H 20.5"
                                          Stroke="#C7D2FE" StrokeThickness="1.4" />
                                    <Path Data="M 18.5,2 L 19.4,4.1 L 21.5,5 L 19.4,5.9 L 18.5,8 L 17.6,5.9 L 15.5,5 L 17.6,4.1 Z"
                                          Fill="#FDE68A" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Locifab"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SidebarTextBrush}" />
                            <TextBlock Text="本地文件工坊"
                                       FontSize="9.5"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource SidebarMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="24,12,16,8"
                      Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="功能模块"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SidebarMutedBrush}" />
                    <TextBlock Text="分类配色"
                               FontSize="8.5"
                               Foreground="{DynamicResource SidebarMutedBrush}"
                               Opacity="0.72"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="2" Margin="12,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Style="{StaticResource HomeNavButton}"
                            Command="{Binding OpenHomeCommand}"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,4"
                            MouseEnter="PinnedButton_MouseEnter"
                            MouseLeave="PinnedButton_MouseLeave"
                            ToolTip="开始使用">
                        <Grid>
                            <Border Margin="-12,-8" CornerRadius="9"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Background" Value="Transparent" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Width="42" Height="42" CornerRadius="12" Margin="-6,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsHomeActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Path Data="M 3,10.5 L 10,4 L 17,10.5 M 5.5,9.5 V 17 H 14.5 V 9.5"
                                      Width="22" Height="22" Stretch="Uniform"
                                      Stroke="{DynamicResource SidebarTextBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Path Data="M 3,10.5 L 10,4 L 17,10.5 M 5.5,9.5 V 17 H 14.5 V 9.5"
                                  Stroke="{DynamicResource SidebarTextBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Width" Value="18" />
                                        <Setter Property="Height" Value="18" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="开始使用 · 新手引导" Margin="32,0,0,0" VerticalAlignment="Center"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </Button>
                    <Button Grid.Row="1" Style="{StaticResource PipelineNavButton}"
                            Command="{Binding OpenPipelineCommand}"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,7"
                            MouseEnter="PinnedButton_MouseEnter"
                            MouseLeave="PinnedButton_MouseLeave"
                            ToolTip="任务流水线">
                        <Grid>
                            <Border Margin="-12,-8" CornerRadius="9"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Background" Value="Transparent" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Width="42" Height="42" CornerRadius="12" Margin="-6,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsPipelineActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Path Data="M 3,4 H 8 V 9 H 3 Z M 12,11 H 17 V 16 H 12 Z M 5.5,9 V 14 H 12 M 12,6 H 17"
                                      Width="22" Height="22" Stretch="Uniform"
                                      Stroke="{DynamicResource SidebarTextBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Path Data="M 3,4 H 8 V 9 H 3 Z M 12,11 H 17 V 16 H 12 Z M 5.5,9 V 14 H 12 M 12,6 H 17"
                                  Stroke="{DynamicResource SidebarTextBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Width" Value="18" />
                                        <Setter Property="Height" Value="18" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="任务流水线 · 自动化" Margin="32,0,0,0" VerticalAlignment="Center"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </Button>
                    <ListBox x:Name="NavList"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             ItemTemplate="{StaticResource NavItemTemplate}"
                             ContextMenu="{StaticResource NavContextMenu}"
                             PreviewMouseRightButtonDown="NavList_PreviewMouseRightButtonDown">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    </ListBox>
                </Grid>

                <Border Grid.Row="3"
                        Margin="16,12,16,18"
                        Padding="13,12"
                        CornerRadius="12"
                        Background="{DynamicResource SidebarFooterBrush}"
                        BorderBrush="{DynamicResource SidebarFooterLineBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#63BF92" VerticalAlignment="Center" />
                            <TextBlock Text="完全离线运行"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SidebarTextBrush}"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="文件与日志只保存在本机"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource SidebarMutedBrush}"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="v11.0.3  ·  Sudfry · 完全离线"
                                   FontSize="9"
                                   Foreground="{DynamicResource SidebarMutedBrush}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TopBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid x:Name="TitleBarDragRegion"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding ToggleSidebarCommand}"
                                Content="☰"
                                Width="38" Height="34" Padding="0" FontSize="17"
                                Margin="0,0,10,0"
                                ToolTip="收起 / 展开左侧栏" />
                        <Button Style="{StaticResource WindowButtonStyle}" Command="{Binding BackCommand}"
                                ToolTip="返回上一个页面" Margin="0,0,2,0">
                            <Path Data="M 13,4 L 6,10 L 13,16" Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource InkSoftBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                        <Button Style="{StaticResource WindowButtonStyle}" Command="{Binding ForwardCommand}"
                                ToolTip="前往下一个页面" Margin="0,0,10,0">
                            <Path Data="M 7,4 L 14,10 L 7,16" Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource InkSoftBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                        <ToggleButton x:Name="PresetToggle" Style="{StaticResource TitleBarToggleStyle}"
                                      ToolTip="保存/导入当前功能配置" Margin="0,0,8,0">
                            <TextBlock Text="配置" FontSize="10" FontWeight="SemiBold" />
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=PresetToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=PresetToggle}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="14" Width="330" Margin="0,6,0,0">
                                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.18" Direction="270" /></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{Binding PageTitle}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="保存当前功能设置，或导入为流水线步骤。" FontSize="9.5"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,10" />
                                    <TextBlock Text="配置名称" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ToolPresetName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="已保存配置" Style="{StaticResource FieldLabel}" Margin="0,9,0,6" />
                                    <ComboBox Style="{StaticResource InputComboBox}" ItemsSource="{Binding ToolPresets}"
                                              DisplayMemberPath="Name" SelectedItem="{Binding SelectedToolPreset, Mode=TwoWay}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource PrimaryButton}" Content="保存" Command="{Binding SaveToolPresetCommand}" />
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="应用" Command="{Binding ApplyToolPresetCommand}" />
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource GhostButton}" Content="导出" Command="{Binding ExportToolPresetCommand}" />
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="导入" Command="{Binding ImportToolPresetCommand}" />
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource GhostButton}" Content="删除" Command="{Binding DeleteToolPresetCommand}" />
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="加入流水线" Command="{Binding AddPresetToPipelineCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <TextBlock Text="LOCIFAB"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" />
                        <Border Width="1" Height="13" Background="{DynamicResource BorderStrongBrush}" Margin="11,0" />
                        <TextBlock Text="{Binding PageTitle}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Border Background="{DynamicResource SuccessSoftBrush}"
                                CornerRadius="10"
                                Padding="9,4"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="离线可用"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>

                        <ToggleButton x:Name="QuickSettingsToggle"
                                      Style="{StaticResource TitleBarToggleStyle}"
                                      ToolTip="快速设置"
                                      Margin="0,0,4,0">
                            <Path Data="M 10,3.2 L 11.1,5.1 L 13.3,5.7 L 15,4.7 L 16.3,6.5 L 15,8.2 L 15.2,10.4 L 16.5,12 L 15,13.7 L 13.2,12.8 L 11.2,13.5 L 10,15.4 L 8.4,14.2 L 6.2,14.1 L 5,12.4 L 3.4,11.4 L 3.8,9.4 L 3.2,7.5 L 4.8,6.3 L 5.5,4.3 L 7.5,3.8 Z M 10,7.2 A 2.8,2.8 0 1 1 10,12.8 A 2.8,2.8 0 1 1 10,7.2"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" />
                        </ToggleButton>

                        <Button Style="{StaticResource WindowButtonStyle}"
                                Click="Minimize_Click"
                                ToolTip="最小化"
                                Content="—" />
                        <Button Style="{StaticResource WindowButtonStyle}"
                                Click="Maximize_Click"
                                x:Name="MaximizeButton"
                                ToolTip="最大化">
                            <TextBlock x:Name="MaximizeGlyph" Text="□" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource CloseWindowButtonStyle}"
                                Click="Close_Click"
                                ToolTip="关闭"
                                Content="✕" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" VerticalAlignment="Top" Margin="26,6,26,0" Padding="12,6"
                    Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Panel.ZIndex="5"
                    IsHitTestVisible="False">
                <TextBlock Text="{Binding PageIntro}" FontSize="9.5"
                           Foreground="{DynamicResource AccentInkBrush}" TextTrimming="CharacterEllipsis" />
            </Border>

            <Grid Grid.Row="1" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="520" Height="520" Fill="{DynamicResource AccentSoftBrush}" Opacity="0.45"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-220,-180,0" />
                <Ellipse Width="360" Height="360" Fill="{DynamicResource WarmSoftBrush}" Opacity="0.28"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-160,0,0,-190" />
            </Grid>

            <ScrollViewer x:Name="PageScroll"
                          Grid.Row="1"
                          Margin="26,50,26,22"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Focusable="False">
                <ContentControl x:Name="PageHost"
                                MinWidth="860"
                                MinHeight="{Binding ViewportHeight, ElementName=PageScroll}"
                                Content="{Binding CurrentPage}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PageScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="PageTranslate" Y="0" />
                        </TransformGroup>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </ScrollViewer>

            <Grid x:Name="DropOverlay"
                  Grid.Row="1"
                  Margin="18,10,18,14"
                  Panel.ZIndex="40"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2"
                        CornerRadius="18"
                        Opacity="0.97">
                    <Grid Margin="10">
                        <Rectangle Stroke="{DynamicResource AccentBrush}"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="6 4"
                                   RadiusX="12" RadiusY="12"
                                   Fill="Transparent" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="54" Height="54" CornerRadius="16"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="↓" FontSize="26" Foreground="White"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="松开以导入"
                                       FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentInkBrush}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock x:Name="DropTargetText"
                                       FontSize="11"
                                       Foreground="{DynamicResource InkSoftBrush}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <TextBlock x:Name="DropFileText"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Popup x:Name="QuickSettingsPopup"
                   PlacementTarget="{Binding ElementName=QuickSettingsToggle}"
                   Placement="Bottom"
                   HorizontalOffset="-282"
                   VerticalOffset="6"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Slide"
                   IsOpen="{Binding IsChecked, ElementName=QuickSettingsToggle, Mode=TwoWay}"
                   DataContext="{Binding DataContext, ElementName=RootWindow}">
                <Border Width="360" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.16"
                                          Color="#1B2927" Direction="270" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="快速设置" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="常用外观与默认行为" FontSize="9.5"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="6"
                                    Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="绂荤嚎" FontSize="9" Foreground="{DynamicResource SuccessBrush}" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="外观主题" Style="{StaticResource FieldLabel}" />
                                <ComboBox Style="{StaticResource InputComboBox}"
                                          ItemsSource="{Binding Settings.ThemeOptions}"
                                          ItemTemplate="{StaticResource DisplayNameOptionTemplate}"
                                          SelectedItem="{Binding Settings.SelectedTheme, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="主题色" Style="{StaticResource FieldLabel}" />
                                <ComboBox Style="{StaticResource InputComboBox}"
                                          ItemsSource="{Binding Settings.AccentOptions}"
                                          ItemTemplate="{StaticResource DisplayNameOptionTemplate}"
                                          SelectedItem="{Binding Settings.SelectedAccent, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="启用界面动画"
                                  IsChecked="{Binding Settings.AnimationsEnabled, Mode=TwoWay}"
                                  Margin="0,0,0,10" />
                        <CheckBox Content="记住上次打开的页面"
                                  IsChecked="{Binding Settings.RememberLastPage, Mode=TwoWay}"
                                  Margin="0,0,0,10" />
                        <CheckBox Content="默认包含子文件夹"
                                  IsChecked="{Binding Settings.DefaultIncludeSubfolders, Mode=TwoWay}"
                                  Margin="0,0,0,12" />

                        <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="9" Padding="11,9"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="去重相似度阈值" FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock Text="{Binding Settings.DedupThresholdLabel}" FontSize="10"
                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Minimum="50" Maximum="100" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Margin="0,4,0,0"
                                        Value="{Binding Settings.DedupThreshold, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding OpenSettingsCommand}"
                                Click="OpenSettingsFromQuick_Click"
                                Content="打开完整设置  →"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
        </Grid>
</Window>

