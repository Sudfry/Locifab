<UserControl x:Class="LocalCraft.App.Views.WatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WatchViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="实时监控" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                            Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="只发现 · 不改文件" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentInkBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="盯着一个文件夹，把刚刚发生变化的文件记下来。监控本身不会移动、改写或删除任何文件。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource SuccessSoftBrush}" CornerRadius="8"
                    Padding="10,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="9.5" Margin="6,0,0,0"
                               Foreground="{DynamicResource SuccessBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="监控文件夹" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Text="选择要盯的目录；变化只会进入队列，不会自动处理。"
                                   FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <CheckBox Content="包含子文件夹" IsChecked="{Binding IncludeSubfolders}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" IsEnabled="{Binding IsIdle}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" ToolTip="{Binding Folder}" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseCommand}" Content="选择文件夹" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartCommand}" Content="开始监控" Margin="7,0,0,0" />
                    <Button Grid.Column="3" Style="{StaticResource GhostButton}"
                            Command="{Binding StopCommand}" Content="停止" Margin="4,0,0,0" />
                    <Button Grid.Column="4" Style="{StaticResource GhostButton}"
                            Command="{Binding OpenFolderCommand}" Content="打开目录" Margin="4,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource WarningSoftBrush}" CornerRadius="9"
                Padding="12,9" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="为什么不做「监控到就自动处理」" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource WarningBrush}" />
                <TextBlock Text="自动处理意味着你还没看过预览，文件就已经被动了。监控只负责发现，处理仍然走「先预览、再执行、可回退」。"
                           FontSize="9.5" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="16,12,16,8">
                    <StackPanel>
                        <TextBlock Text="变化队列" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryText}" FontSize="9.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ClearCommand}"
                            Content="清空队列" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <DataGrid Grid.Row="1" Style="{StaticResource PreviewDataGrid}"
                          ItemsSource="{Binding Changes}" Margin="8,0,8,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="变化" Binding="{Binding ChangeType}" Width="70" />
                        <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="*" />
                        <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="60" />
                        <DataGridTextColumn Header="最近一次" Binding="{Binding LastSeenText}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="2" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="0,0,13,13"
                        Padding="16,9">
                    <TextBlock Text="提示：停止监控只会停止监听，队列仍然保留，方便你稍后处理。"
                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
