<UserControl x:Class="LocalCraft.App.Views.DedupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DedupViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="内容级去重" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                            Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MODULE 03" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="提取文档文本并计算 64 位 SimHash 指纹，识别内容相似但文件名或格式不同的文档。全部本地计算。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}" Content="↩  回退中心"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,10"
                IsEnabled="{Binding IsIdle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="待比较文档" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkSoftBrush}" Margin="8,0,14,0"
                                   VerticalAlignment="Center" />
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddFilesCommand}"
                                Content="添加文件" Margin="0,0,6,0" />
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddFolderCommand}"
                                Content="添加文件夹" Margin="0,0,12,0" />
                        <CheckBox Content="包含子文件夹" IsChecked="{Binding IncludeSubfolders}"
                                  VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCommand}"
                                Content="分析内容" MinHeight="36" Padding="16,7" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ClearCommand}"
                                Content="清空" FontSize="10.5" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding QueueCountText}" FontSize="10.5"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="相似度阈值" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,9,0" />
                    <Slider Grid.Column="1" Minimum="50" Maximum="100" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            Value="{Binding ThresholdPercent, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Text="{Binding ThresholdLabel}" FontSize="11"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                               Width="42" Margin="8,0,16,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="隔离文件夹" FontSize="10.5"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                               Margin="0,0,9,0" />
                    <TextBox Grid.Column="4" Style="{StaticResource InputTextBox}" MinHeight="32"
                             Padding="9,5" AutomationProperties.Name="重复文件隔离目录"
                             Text="{Binding QuarantineDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="5" Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseQuarantineCommand}" Content="浏览…"
                            Margin="7,0,0,0" MinHeight="32" />
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="#C9E0D9" BorderThickness="1"
                    CornerRadius="8" Padding="10,7" Margin="0,0,0,7"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding NoticeText}" FontSize="10.5"
                           Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{DynamicResource WarningSoftBrush}" BorderBrush="#EAD6AC" BorderThickness="1"
                    CornerRadius="8" Padding="10,7" Margin="0,0,0,7"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="移出后可在回退中心恢复；每个相似组会保留一个基准文件。" FontSize="10"
                           Foreground="{DynamicResource WarningBrush}" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Groups.Count, StringFormat=相似组 {0}}" FontSize="11.5"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding GroupsSummary}" FontSize="10.5"
                               Foreground="{DynamicResource MutedBrush}" Margin="12,1,0,0" />
                    <TextBlock Text="{Binding AnalyzedCount, StringFormat=已分析 {0} 个文档}" FontSize="10"
                               Foreground="{DynamicResource MutedBrush}" Margin="12,1,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ExecuteHint}" FontSize="10"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="相似文档组" FontSize="12.5" FontWeight="SemiBold" Margin="16,14,16,9" />
                        <Grid Grid.Row="1" Margin="12,0,12,10">
                            <ListBox Style="{StaticResource JournalListBox}"
                                     ItemsSource="{Binding Groups}"
                                     SelectedItem="{Binding SelectedGroup, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Summary}" FontSize="9.5"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Margin="8,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding RepresentativeName}" FontSize="10"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18"
                                        Visibility="{Binding HasGroups, Converter={StaticResource InverseBoolToVisibility}}">
                                <Border Width="42" Height="42" CornerRadius="12"
                                        Background="{DynamicResource SurfaceMutedBrush}" HorizontalAlignment="Center">
                                    <TextBlock Text="同" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="还没有相似组" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Text="添加文档并点击「分析内容」。"
                                           FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="16,14,16,9">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedGroup.Title, StringFormat=相似组详情 · {0}}"
                                           FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="复选框控制是否移出；每组第一个文件为保留基准。"
                                           FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <DataGrid Style="{StaticResource PreviewDataGrid}"
                                      ItemsSource="{Binding SelectedGroup.Files}"
                                      IsEnabled="{Binding IsIdle}"
                                      Visibility="{Binding HasSelectedGroup, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="52" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsIncludedForRemoval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanToggle}" HorizontalAlignment="Center"
                                                          ToolTip="勾选表示移出到隔离文件夹" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="文件" Width="1.1*" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FilePath}" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="大小" Width="76" Binding="{Binding SizeText}" CanUserSort="False" />
                                    <DataGridTemplateColumn Header="相似度" Width="92" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SimilarityText}" FontSize="10.5"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="移出到" Width="1.5*" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TargetDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetDisplay}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="文本预览" Width="1.4*" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Preview}" FontSize="10"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Preview}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Background="{DynamicResource CardBrush}"
                                    Visibility="{Binding HasSelectedGroup, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="选择一个相似组查看文件" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="相似度、文本预览和隔离位置会显示在这里。"
                                               FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="16,10">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="安全策略：保留至少一个基准文件；移出后源文件可从日志恢复。"
                                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedRemovalCount, StringFormat=已选择 {0} 个重复项移出}"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="4" CornerRadius="10" Padding="13,10" Margin="0,10,0,0"
                infra:FadeSlide.IsEnabled="True"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="#C9E4D6" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="#ECC9C1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ResultTitle}" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ResultMessage}" FontSize="10.5"
                               Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                        Command="{Binding OpenUndoCenterCommand}" Content="打开回退中心 →"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ExecuteHint}" FontSize="10.5"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SkippedCount, StringFormat=已跳过 {0} 个无文本或过短的文档}"
                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource WarningButton}"
                        Command="{Binding ExecuteCommand}" Content="移出选中重复项  →"
                        MinWidth="180" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,8,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Height="5" Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceMutedBrush}" BorderThickness="0" />
                <TextBlock Text="{Binding BusyText}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
