<UserControl x:Class="LocalCraft.App.Views.ArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ArchiveViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="压缩与解压" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                            Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ZIP · 安全解压 · 可回退" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentInkBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="把文件夹打包成 ZIP，或把 ZIP 安全解压到目标目录。解压不会覆盖任何已有文件。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}" Content="↩  回退中心"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="处理方式" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource InputComboBox}"
                              ItemsSource="{Binding Modes}"
                              ItemTemplate="{StaticResource DisplayNameOptionTemplate}"
                              SelectedItem="{Binding SelectedMode, Mode=TwoWay}" />
                    <TextBlock Text="{Binding SelectedMode.Description}" FontSize="9"
                               Foreground="{DynamicResource MutedBrush}" Margin="1,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                    <TextBlock Text="输出会写入本地日志；解压遇到同名文件时自动加序号。"
                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding SourceLabel}" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="只读；不会修改源。" FontSize="9.5"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" ToolTip="{Binding SourcePath}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseSourceCommand}" Content="选择" Margin="7,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding TargetLabel}" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="目标目录已存在时只补齐，不删除任何文件。" FontSize="9.5"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" ToolTip="{Binding TargetPath}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseTargetCommand}" Content="选择" Margin="7,0,0,0" />
                    </Grid>
                    <StackPanel Margin="0,9,0,0">
                        <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="留空则生成普通 ZIP；填写后使用 ZIP 密码加密。解压加密包时也必须填写。" />
                        <TextBlock Text="{Binding PasswordHint}" FontSize="9" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" Margin="1,5,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="16,12,16,8">
                    <StackPanel>
                        <TextBlock Text="归档预览" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryText}" FontSize="9.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="1" Style="{StaticResource PreviewDataGrid}"
                          ItemsSource="{Binding Entries}" Margin="8,0,8,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="条目" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="16,10,16,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ScanCommand}"
                                Content="只读检查" Margin="0,0,7,0" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}"
                                Content="执行 ZIP 操作" />
                    </StackPanel>
                    <TextBlock Text="输出文件可在回退中心删除，源文件永远不改。"
                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                Padding="12,8" Margin="0,10,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding BusyText}" FontSize="10" Foreground="{DynamicResource AccentInkBrush}" />
                <ProgressBar Height="4" Margin="0,7,0,0" Minimum="0" Maximum="100"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" CornerRadius="10" Padding="13,10" Margin="0,10,0,0"
                infra:FadeSlide.IsEnabled="True"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding ResultTitle}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ResultMessage}" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource InkSoftBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
