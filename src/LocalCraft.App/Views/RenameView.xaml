<UserControl x:Class="LocalCraft.App.Views.RenameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:services="clr-namespace:LocalCraft.App.Services"
             xmlns:controls="clr-namespace:LocalCraft.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RenameViewModel}"
             AllowDrop="True"
             DragOver="Root_DragOver"
             Drop="Root_Drop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="批量重命名" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="12,2,0,0"
                            VerticalAlignment="Center">
                    </Border>
                </StackPanel>
                <TextBlock Text="先预览、再执行、可回退。预览阶段只读，不修改任何文件。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}"
                    VerticalAlignment="Center"
                    Content="↩  回退中心" />
        </Grid>

        <!-- Folder -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,12"
                IsEnabled="{Binding IsIdle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="工作文件夹" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkSoftBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <controls:PathTextBox Grid.Column="1"
                                          AutomationProperties.Name="文件夹路径"
                                          Text="{Binding FolderPath, Mode=TwoWay}" />

                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseCommand}"
                            Content="浏览…"
                            Margin="8,0,0,0" />
                    <Button Grid.Column="3"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanCommand}"
                            Content="扫描"
                            MinWidth="82"
                            Margin="8,0,0,0"
                            MinHeight="38"
                            Padding="18,7" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Content="包含子文件夹"
                              IsChecked="{Binding IncludeSubfolders}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="扩展名筛选"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="24,0,9,0"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="2"
                             Style="{StaticResource InputTextBox}"
                             AutomationProperties.Name="扩展名筛选"
                             Width="260"
                             MinHeight="32"
                             Padding="9,5"
                             Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="例如：docx, pdf, jpg；留空表示全部文件" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="排序" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Style="{StaticResource InputComboBox}" Width="130" MinHeight="32"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Background="{DynamicResource WarningSoftBrush}"
                        CornerRadius="7"
                        Padding="10,7"
                        Margin="0,9,0,0"
                        Visibility="{Binding HasScanWarning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ScanWarning}"
                               FontSize="10.5"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <!-- Rules -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,10"
                IsEnabled="{Binding IsIdle}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="重命名规则" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" />
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ResetRulesCommand}"
                            Content="恢复默认规则"
                            FontSize="10.5" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="在名称前添加" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputTextBox}"
                                 AutomationProperties.Name="名称前缀"
                                 Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如：2026_ ，会加在文件名主体之前" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="在名称后添加" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputTextBox}"
                                 AutomationProperties.Name="名称后缀"
                                 Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如：_归档 ，会加在扩展名之前" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="查找替换规则（可加多组，按顺序执行）"
                                   Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="查找文字" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Grid.Column="2" Text="替换为" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
                        </Grid>
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReplaceRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="38" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource InputTextBox}"
                                                     Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="要查找的文字" />
                                            <TextBox Grid.Column="2" Style="{StaticResource InputTextBox}"
                                                     Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="留空会删除查找到的文字" />
                                            <Button Grid.Column="3" Style="{StaticResource CompactButton}"
                                                    Content="✕" ToolTip="删除这一组" FontSize="10"
                                                    Command="{Binding RemoveCommand}"
                                                    HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource CompactButton}"
                            Content="＋ 添加一组"
                            Command="{Binding AddReplaceRuleCommand}"
                            VerticalAlignment="Bottom" Margin="10,0,0,4" />
                </Grid>

                <WrapPanel Margin="0,11,0,0" VerticalAlignment="Center">
                    <CheckBox Content="查找时区分大小写"
                              IsChecked="{Binding MatchCase}"
                              Margin="0,0,20,6" />
                    <CheckBox Content="查找范围包含扩展名"
                              IsChecked="{Binding IncludeExtension}"
                              Margin="0,0,22,6" />

                    <Border Width="1" Height="17" Background="{DynamicResource BorderBrush}"
                            Margin="0,1,20,6" />

                    <CheckBox Content="添加序号"
                              IsChecked="{Binding UseNumbering}"
                              Margin="0,0,12,6"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource InkSoftBrush}" />

                    <TextBlock Text="起始" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Style="{StaticResource InputTextBox}" Width="54" MinHeight="30"
                             Padding="7,4" Margin="0,0,12,6"
                             Text="{Binding StartNumberText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="位数" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Style="{StaticResource InputTextBox}" Width="44" MinHeight="30"
                             Padding="7,4" Margin="0,0,12,6"
                             Text="{Binding NumberPaddingText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="分隔符" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Style="{StaticResource InputTextBox}" Width="52" MinHeight="30"
                             Padding="7,4" Margin="0,0,18,6"
                             Text="{Binding NumberSeparator, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="序号置于名称前"
                              IsChecked="{Binding NumberBeforeName}"
                              Margin="0,0,0,6" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Summary -->
        <Grid Grid.Row="3" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalCount}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}" />
                <TextBlock Text=" 个文件" FontSize="11" Foreground="{DynamicResource MutedBrush}" />

                <Border Width="1" Height="12" Background="{DynamicResource BorderStrongBrush}" Margin="14,0" />

                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text=" 待重命名 " FontSize="11" Foreground="{DynamicResource InkSoftBrush}" />
                <TextBlock Text="{Binding SelectedRenameCount}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource SuccessBrush}" />

                <Ellipse Width="6" Height="6" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="15,0,0,0" />
                <TextBlock Text=" 覆盖 " FontSize="11" Foreground="{DynamicResource InkSoftBrush}" />
                <TextBlock Text="{Binding SelectedOverwriteCount}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource WarningBrush}" />

                <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="15,0,0,0" />
                <TextBlock Text=" 冲突 " FontSize="11" Foreground="{DynamicResource InkSoftBrush}" />
                <TextBlock Text="{Binding ConflictCount}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource DangerBrush}" />

                <Ellipse Width="6" Height="6" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="15,0,0,0" />
                <TextBlock Text=" 无变化 " FontSize="11" Foreground="{DynamicResource InkSoftBrush}" />
                <TextBlock Text="{Binding UnchangedCount}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}"
                        Command="{Binding ClearConflictsCommand}"
                        Content="取消全部冲突项"
                        Margin="0,0,4,0"
                        FontSize="10.5" />
                <Button Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshPreviewCommand}"
                        Content="刷新预览"
                        FontSize="10.5" />
            </StackPanel>
        </Grid>

        <!-- Preview table -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,13,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="预览对照表" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="{Binding PreviewHint}"
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="只读预览" FontSize="9.5"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="5,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource DangerSoftBrush}"
                        CornerRadius="8"
                        Padding="11,7"
                        Margin="16,0,16,10"
                        Visibility="{Binding HasIncludedConflicts, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="{Binding IncludedConflictCount, StringFormat=有 {0} 个冲突项已勾选，执行已锁定。请取消勾选冲突项，或调整规则后重新预览。}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,88,0" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding ClearConflictsCommand}"
                                Content="取消勾选"
                                Foreground="{DynamicResource DangerBrush}"
                                FontSize="10.5"
                                Padding="8,2" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <DataGrid Style="{StaticResource PreviewDataGrid}"
                              AutomationProperties.Name="重命名预览表"
                              ItemsSource="{Binding PreviewRows}"
                              IsEnabled="{Binding IsIdle}"
                              Visibility="{Binding HasPreviewRows, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="46" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanToggle}"
                                                  HorizontalAlignment="Center"
                                                  ToolTip="勾选纳入本次批量操作" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="#" Width="44" Binding="{Binding IndexText}" CanUserSort="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                        <Setter Property="FontSize" Value="10.5" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="原文件名" Width="1.1*" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OriginalName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SourcePath}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="新文件名" Width="1.2*" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="NewNameText"
                                                   Text="{Binding ProposedName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TargetPath}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StatusKey}" Value="conflict">
                                                <Setter TargetName="NewNameText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKey}" Value="invalid">
                                                <Setter TargetName="NewNameText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKey}" Value="overwrite">
                                                <Setter TargetName="NewNameText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKey}" Value="unchanged">
                                                <Setter TargetName="NewNameText" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                <Setter TargetName="NewNameText" Property="FontWeight" Value="Normal" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="状态" Width="106" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StatusBadge"
                                                Background="{DynamicResource NeutralBadgeBrush}"
                                                CornerRadius="5"
                                                Padding="8,3"
                                                HorizontalAlignment="Left">
                                            <TextBlock x:Name="StatusTextBlock"
                                                       Text="{Binding StatusText}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StatusKey}" Value="ready">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                <Setter TargetName="StatusTextBlock" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKey}" Value="overwrite">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                <Setter TargetName="StatusTextBlock" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKey}" Value="conflict">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                <Setter TargetName="StatusTextBlock" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKey}" Value="invalid">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                <Setter TargetName="StatusTextBlock" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="说明" Width="1.5*" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Note}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Note}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{DynamicResource CardBrush}"
                            Visibility="{Binding HasPreviewRows, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,18">
                            <Border Width="42" Height="42"
                                    CornerRadius="12"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="预"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="预览会出现在这里"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="选择文件夹并设置规则。所有结果先在内存中计算，不会改动文件。"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Result -->
        <Border Grid.Row="5"
                CornerRadius="10"
                Padding="13,10"
                Margin="0,10,0,0"
                infra:FadeSlide.IsEnabled="True"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="#C9E4D6" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="#ECC9C1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource CardBrush}" VerticalAlignment="Top">
                    <TextBlock FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="✓" />
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultIsSuccess}" Value="False">
                                        <Setter Property="Text" Value="!" />
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,12,0">
                    <TextBlock Text="{Binding ResultTitle}"
                               FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ResultMessage}"
                               FontSize="10.5"
                               Foreground="{DynamicResource InkSoftBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding OpenUndoCenterCommand}"
                        Content="打开回退中心 →"
                        FontSize="10.5"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Footer actions -->
        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <CheckBox Content="允许覆盖同名文件（覆盖前自动备份，可回退）"
                              IsChecked="{Binding AllowOverwrite}"
                              IsEnabled="{Binding IsIdle}" />
                    <TextBlock Text="{Binding ExecuteHint}"
                               FontSize="10.5"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,6,18,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ExecuteCommand}"
                        Content="执行重命名  →"
                        MinWidth="166"
                        VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="0,10,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Height="5"
                             Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource SurfaceMutedBrush}"
                             BorderThickness="0" />
                <TextBlock Text="{Binding BusyText}"
                           FontSize="10"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
