<Window x:Class="LocalCraft.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24,20"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10"
                            Background="{DynamicResource WarningSoftBrush}">
                        <TextBlock Text="!" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" Content="✕"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="Cancel_Click" />
            </Grid>
            <TextBlock x:Name="MessageText" Grid.Row="1" FontSize="11.5"
                       TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}"
                       Margin="0,14,0,0" LineHeight="20" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="取消"
                        MinWidth="88" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Style="{StaticResource PrimaryButton}" Content="确认"
                        MinWidth="88" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
