<UserControl x:Class="LocalCraft.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BackupViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="备份同步" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                            Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="只增不删 · 可回退" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentInkBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="把源文件夹补齐到目标文件夹。相同文件跳过，更新前备份目标版本，不删除任何东西。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}" Content="↩  回退中心"
                    VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="源文件夹" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="要备份的内容，分析阶段只读。" FontSize="9.5"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" ToolTip="{Binding SourceFolder}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseSourceCommand}" Content="选择" Margin="7,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="目标文件夹" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="目录结构与源保持一致，只补齐和更新。" FontSize="9.5"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" ToolTip="{Binding TargetFolder}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseTargetCommand}" Content="选择" Margin="7,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="同步方式" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <WrapPanel>
                        <CheckBox Content="包含子文件夹" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,16,7" />
                        <CheckBox Content="跳过隐藏文件" IsChecked="{Binding SkipHidden}" Margin="0,0,16,7" />
                        <CheckBox Content="严格比对（内容哈希）" IsChecked="{Binding StrictCompare}" Margin="0,0,16,7" />
                        <CheckBox Content="复制后 SHA-256 校验" IsChecked="{Binding VerifyAfterCopy}" Margin="0,0,16,7" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="只复制这些扩展名（留空为全部）" FontSize="9.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="1,0,0,4" />
                        <TextBlock Grid.Column="2" Text="跳过这些扩展名" FontSize="9.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="1,0,0,4" />
                        <TextBox Grid.Row="1" Style="{StaticResource InputTextBox}"
                                 Text="{Binding IncludeExtensions, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如 jpg, mp4, docx；留空为全部" />
                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource InputTextBox}"
                                 Text="{Binding ExcludeExtensions, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如 tmp, bak" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="超过此体积跳过（MB）" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource InputTextBox}" Width="90" HorizontalAlignment="Right"
                                 Text="{Binding MaxFileSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="16,12,16,8">
                    <StackPanel>
                        <TextBlock Text="差异预览" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryText}" FontSize="9.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="5" Padding="7,2" Margin="0,0,5,0">
                            <TextBlock Text="{Binding NewCount, StringFormat='新增 {0}'}" FontSize="8.5"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </Border>
                        <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="5" Padding="7,2" Margin="0,0,5,0">
                            <TextBlock Text="{Binding UpdateCount, StringFormat='更新 {0}'}" FontSize="8.5"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </Border>
                        <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="5" Padding="7,2">
                            <TextBlock Text="{Binding SameCount, StringFormat='相同 {0}'}" FontSize="8.5"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="1" Style="{StaticResource PreviewDataGrid}"
                          ItemsSource="{Binding PlanItems}" Margin="8,0,8,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="58" />
                        <DataGridTextColumn Header="相对路径" Binding="{Binding RelativePath}" Width="*" />
                        <DataGridTextColumn Header="体积" Binding="{Binding Size}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="16,10,16,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ScanCommand}"
                                Content="只读分析" Margin="0,0,7,0" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}"
                                Content="执行备份（更新前先备份）" />
                    </StackPanel>
                    <TextBlock Text="目标里的额外文件不会被删除。"
                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                Padding="12,8" Margin="0,10,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding BusyText}" FontSize="10" Foreground="{DynamicResource AccentInkBrush}" />
                <ProgressBar Height="4" Margin="0,7,0,0" Minimum="0" Maximum="100"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" CornerRadius="10" Padding="13,10" Margin="0,10,0,0"
                infra:FadeSlide.IsEnabled="True"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding ResultTitle}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ResultMessage}" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource InkSoftBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
