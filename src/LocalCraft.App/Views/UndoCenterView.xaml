<UserControl x:Class="LocalCraft.App.Views.UndoCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UndoCenterViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="回退中心" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="12,2,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="本地日志"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="每个批量操作都会记录完整的旧路径 → 新路径。回退不依赖系统撤销，也不受时间限制。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="{Binding DataContext.UndoReturnLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.ReturnFromUndoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Visibility="{Binding DataContext.CanReturnFromUndo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,6,0" />
                <Button Style="{StaticResource GhostButton}"
                        Command="{Binding OpenJournalFolderCommand}"
                        Content="打开日志目录"
                        Margin="0,0,6,0" />
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Content="刷新记录" />
            </StackPanel>
        </Grid>

        <!-- Result banner -->
        <Border Grid.Row="1"
                CornerRadius="10"
                Padding="12,9"
                Margin="0,0,0,10"
                infra:FadeSlide.IsEnabled="True"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="#C9E4D6" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="#ECC9C1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="{DynamicResource InkSoftBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Warnings -->
        <Border Grid.Row="2"
                Background="{DynamicResource WarningSoftBrush}"
                CornerRadius="8"
                Padding="10,7"
                Margin="0,0,0,10"
                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding WarningsText}"
                       FontSize="10.5"
                       Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Master / detail -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Journal list -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,14,16,10">
                        <StackPanel>
                            <TextBlock Text="操作记录" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding JournalCountText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                CornerRadius="6" Padding="7,3">
                            <TextBlock Text="JSON 日志" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="12,0,12,10">
                        <ListBox Style="{StaticResource JournalListBox}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Height="560"
                                 ItemsSource="{Binding Journals}"
                                 SelectedItem="{Binding SelectedJournal, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Border x:Name="JournalStatusBadge"
                                                    Background="{DynamicResource NeutralBadgeBrush}"
                                                    CornerRadius="5"
                                                    Padding="7,3"
                                                    HorizontalAlignment="Left">
                                                <TextBlock x:Name="JournalStatusText"
                                                           Text="{Binding StatusText}"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource CompactButton}" Content="✕" ToolTip="删除这条记录"
                                                        FontSize="10" Foreground="{DynamicResource DangerBrush}" Padding="6,2" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.DeleteJournalItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding IdShort, StringFormat=# {0}}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding OperationCountText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Margin="8,1,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding CreatedText}"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding SourceDirectory}"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SourceDirectory}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding UndoHint}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,6,0,0" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding StatusKey}" Value="completed">
                                            <Setter TargetName="JournalStatusBadge" Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                            <Setter TargetName="JournalStatusText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKey}" Value="undone">
                                            <Setter TargetName="JournalStatusBadge" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="JournalStatusText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKey}" Value="failed">
                                            <Setter TargetName="JournalStatusBadge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                            <Setter TargetName="JournalStatusText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKey}" Value="rolledback">
                                            <Setter TargetName="JournalStatusBadge" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                            <Setter TargetName="JournalStatusText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="20"
                                    Visibility="{Binding HasJournals, Converter={StaticResource InverseBoolToVisibility}}">
                            <Border Width="42" Height="42" CornerRadius="12"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="回" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="还没有操作记录"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="完成一次批量重命名后，日志会出现在这里。"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,10"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <ProgressBar Height="4"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding ProgressValue, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource SurfaceMutedBrush}"
                                         BorderThickness="0" />
                            <TextBlock Text="{Binding BusyText}"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Detail -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,16,18,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="36" Height="36" CornerRadius="10"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    VerticalAlignment="Top">
                                <TextBlock Text="回" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="11,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedJournal.DisplayName}"
                                               FontSize="12.5" FontWeight="SemiBold" />
                                    <Border CornerRadius="5" Padding="7,2" Margin="8,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource NeutralBadgeBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedJournal.StatusKey}" Value="completed">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedJournal.StatusKey}" Value="undone">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedJournal.StatusKey}" Value="failed">
                                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SelectedJournal.StatusText}" FontSize="9">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedJournal.StatusKey}" Value="completed">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedJournal.StatusKey}" Value="undone">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedJournal.StatusKey}" Value="failed">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedJournal.TimeRangeText}"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding UndoCommand}"
                                        Content="{Binding SelectedJournal.UndoActionText}"
                                        MinWidth="180" Margin="0,0,0,6" />
                                <Button Style="{StaticResource GhostButton}"
                                        Command="{Binding RevealJournalFileCommand}"
                                        Content="查看日志文件" FontSize="10" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                CornerRadius="8"
                                Padding="11,8"
                                Margin="18,0,18,10">
                            <StackPanel>
                                <TextBlock Text="源文件夹" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding SelectedJournal.SourceDirectory}"
                                           FontSize="10"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedJournal.SourceDirectory}" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <DataGrid Style="{StaticResource PreviewDataGrid}"
                                      AutomationProperties.Name="操作映射表"
                                      ItemsSource="{Binding SelectedJournal.Operations}"
                                      IsEnabled="{Binding IsIdle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Width="40" Binding="{Binding Sequence}" CanUserSort="False">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                <Setter Property="FontSize" Value="10" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="输入 / 原文件" Width="1*" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding OldName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SourcePath}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="输出 / 新文件" Width="1*" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding NewName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding TargetPath}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="所在目录" Width="1.25*" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Directory}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Directory}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="状态" Width="76" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StateText}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Border Grid.Row="3"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="18,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="回退说明" FontSize="9.5"
                                               Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock Text="{Binding SelectedUndoHint}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource InkSoftBrush}"
                                               Margin="0,3,12,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="上方按钮可直接回退此批次"
                                           FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- No selection -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                        <Border Width="48" Height="48" CornerRadius="14"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="↩" FontSize="19"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="选择一条操作记录"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="左侧会列出所有批量操作；选择后可查看完整映射并回退。"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
