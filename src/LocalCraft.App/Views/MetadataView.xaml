<UserControl x:Class="LocalCraft.App.Views.MetadataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MetadataViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="隐私元数据清理" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                            Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="作者 · 公司 · EXIF · 修订信息" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentInkBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="生成不包含作者、公司、标题、修订和 EXIF 等隐藏信息的副本；原文件不修改。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}" Content="↩  回退中心"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="源文件夹" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" ToolTip="{Binding Folder}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseCommand}" Content="选择" Margin="7,0,0,0" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="输出文件夹" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding OutputFolder}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseOutputCommand}" Content="选择" Margin="7,0,0,0" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                    <CheckBox Content="包含子文件夹" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,10,8" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"
                            Content="只读扫描" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="16,12,16,8">
                    <StackPanel>
                        <TextBlock Text="待清理文件" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryText}" FontSize="9.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="1" Style="{StaticResource PreviewDataGrid}"
                          ItemsSource="{Binding Items}" Margin="8,0,8,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="100" />
                        <DataGridTextColumn Header="源文件" Binding="{Binding FileName}" Width="1*" />
                        <DataGridTextColumn Header="输出去元数据副本" Binding="{Binding OutputPath}" Width="1.6*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="16,10,16,12">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}"
                            Content="执行元数据清理" HorizontalAlignment="Left" />
                    <TextBlock Text="支持 DOCX / PPTX / XLSX / JPG / PNG / BMP / TIFF；PDF 暂不处理。"
                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                Padding="12,8" Margin="0,10,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding BusyText}" FontSize="10" Foreground="{DynamicResource AccentInkBrush}" />
                <ProgressBar Height="4" Margin="0,7,0,0" IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" CornerRadius="10" Padding="13,10" Margin="0,10,0,0"
                infra:FadeSlide.IsEnabled="True"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding ResultTitle}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ResultMessage}" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource InkSoftBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
