<UserControl x:Class="LocalCraft.App.Views.TextReplaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TextReplaceViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="文本替换" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                            Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="扫描 · 预览 · 备份 · 回退" FontSize="9"
                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentInkBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="按字面量或正则改写文本内容。二进制文件会被跳过，原文件先备份再修改。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}" Content="↩  回退中心"
                    HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="文件夹" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="扫描只读；只有点击执行后才会改写文件内容。"
                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,7" />
                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" ToolTip="{Binding Folder}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseCommand}" Content="选择文件夹" Margin="10,19,7,0" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ScanCommand}" Content="只读扫描并预览" Margin="0,19,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="查找与替换" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="匹配的是文件内容，不是文件名。替换为空即删除匹配内容。"
                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,10" />
                    <TextBlock Text="查找内容" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" />
                    <TextBlock Text="替换为" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="正则表达式" IsChecked="{Binding UseRegex}" Margin="0,0,18,0" />
                        <CheckBox Content="忽略大小写" IsChecked="{Binding IgnoreCase}" />
                    </StackPanel>
                    <TextBlock Text="正则支持捕获组替换，例如查找 (\d+)-(\d+) 替换为 $2-$1。"
                               FontSize="9" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                               Margin="0,7,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="处理范围" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="默认只处理文本类扩展名，并自动跳过二进制内容。"
                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,10" />
                    <WrapPanel>
                        <CheckBox Content="包含子文件夹" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,18,8" />
                        <CheckBox Content="不限扩展名" IsChecked="{Binding AnyExtension}" Margin="0,0,18,8" />
                    </WrapPanel>
                    <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="只处理这些扩展名" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding IncludeExtensions, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="例如 txt, md, csv；留空使用内置文本名单" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="跳过这些扩展名" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ExcludeExtensions, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="例如 json, log" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="超过此体积跳过（MB）" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Style="{StaticResource InputTextBox}" Width="76" Text="{Binding MaxFileSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="16,12,16,8">
                    <StackPanel>
                        <TextBlock Text="扫描结果与预览" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryText}" FontSize="9.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="6" Padding="8,3" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="命中 " FontSize="9" Foreground="{DynamicResource AccentInkBrush}" />
                            <TextBlock Text="{Binding Occurrences.Count}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentInkBrush}" />
                            <TextBlock Text=" 处 · 已选 " FontSize="9" Foreground="{DynamicResource AccentInkBrush}" />
                            <TextBlock Text="{Binding SelectedCount}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentInkBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <DataGrid Grid.Row="1" Style="{StaticResource PreviewDataGrid}"
                          ItemsSource="{Binding Occurrences}" Margin="8,0,8,0"
                          AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="替换" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                        <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="190" IsReadOnly="True" />
                        <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="55" IsReadOnly="True" />
                        <DataGridTextColumn Header="原文" Binding="{Binding Before}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="替换后" Binding="{Binding After}" Width="*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="16,10,16,12">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}"
                            Content="执行替换（先备份）" HorizontalAlignment="Left" />
                    <TextBlock Text="执行前会再次检查文件是否被改动；修改前写入本地操作日志。"
                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                Padding="12,8" Margin="0,10,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding BusyText}" FontSize="10" Foreground="{DynamicResource AccentInkBrush}" />
                <ProgressBar Height="4" Margin="0,7,0,0" Minimum="0" Maximum="100"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" CornerRadius="10" Padding="13,10" Margin="0,10,0,0"
                infra:FadeSlide.IsEnabled="True"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding ResultTitle}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ResultMessage}" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource InkSoftBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
