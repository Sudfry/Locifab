<UserControl x:Class="LocalCraft.App.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:GuideViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="功能说明" Style="{StaticResource PageTitle}" />
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                        Margin="12,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="每种工具的用途、步骤和安全边界" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentInkBrush}" />
                </Border>
            </StackPanel>
            <TextBlock Text="按分类整理的完整功能说明；新用户可以先看用途，再回到左侧打开对应工具。"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="15,13" Margin="0,0,9,9">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="8"
                                                Background="{Binding CategorySoftBrush}">
                                            <Path Data="{Binding IconData}" Width="16" Height="16"
                                                  Stretch="Uniform" Stroke="{Binding CategoryBrush}"
                                                  StrokeThickness="1.6" StrokeLineJoin="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Category}" FontSize="9"
                                                       Foreground="{Binding CategoryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="{Binding CategorySoftBrush}" CornerRadius="5" Padding="6,2">
                                        <TextBlock Text="{Binding Badge}" FontSize="8.5"
                                                   Foreground="{Binding CategoryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Purpose}" FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource InkSoftBrush}" Margin="0,9,0,0" />
                                <TextBlock Text="{Binding Usage, StringFormat='用法：{0}'}" FontSize="9.5"
                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Safety, StringFormat='安全：{0}'}" FontSize="9.5"
                                           TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}" Margin="0,3,0,0" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="查看详情  →"
                                        HorizontalAlignment="Left"
                                        Margin="0,9,0,0"
                                        Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Key}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        <Popup x:Name="DetailPopup"
               IsOpen="{Binding IsDetailOpen, Mode=TwoWay}"
               Placement="Center"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{Binding SelectedFeature.CategoryBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Width="760"
                    MaxHeight="620"
                    Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.22" Color="#1B2927" Direction="270" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedFeature.Category}" FontSize="10"
                                       Foreground="{Binding SelectedFeature.CategoryBrush}" />
                            <TextBlock Text="{Binding SelectedFeature.Title}" FontSize="22"
                                       FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" Content="✕"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CloseDetailCommand}" />
                    </Grid>
                    <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Margin="0,14,0,10">
                        <StackPanel>
                            <TextBlock Text="用途" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding SelectedFeature.Purpose}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkBrush}" Margin="0,4,0,12" />
                            <TextBlock Text="适用场景" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding SelectedFeature.Scenarios}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkSoftBrush}" Margin="0,4,0,12" />
                            <TextBlock Text="使用步骤" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding SelectedFeature.Usage}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkSoftBrush}" Margin="0,4,0,12" />
                            <TextBlock Text="关键选项" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding SelectedFeature.Options}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkSoftBrush}" Margin="0,4,0,12" />
                            <TextBlock Text="例子" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <Border Background="{Binding SelectedFeature.CategorySoftBrush}" CornerRadius="8"
                                    Padding="11,9" Margin="0,4,0,12">
                                <TextBlock Text="{Binding SelectedFeature.Example}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource InkBrush}" />
                            </Border>
                            <TextBlock Text="输出结果" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding SelectedFeature.Result}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkSoftBrush}" Margin="0,4,0,12" />
                            <TextBlock Text="安全与回退" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="{Binding SelectedFeature.Safety}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkSoftBrush}" Margin="0,4,0,12" />
                            <TextBlock Text="注意事项" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarmBrush}" />
                            <TextBlock Text="{Binding SelectedFeature.Caveats}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkSoftBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="关闭"
                            HorizontalAlignment="Right" MinWidth="96"
                            Command="{Binding CloseDetailCommand}" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
