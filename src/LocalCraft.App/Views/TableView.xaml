<UserControl x:Class="LocalCraft.App.Views.TableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TableViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="表格处理" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                            Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CSV · TSV · XLSX · 合并导出" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentInkBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="读取表格做筛选、排序、选列和合并，结果写成 UTF-8 BOM CSV。扫描与预览都是只读的。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}" Content="↩  回退中心"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="文件夹" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="只读扫描 CSV / TSV / XLSX / XLSM。"
                               FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,5" />
                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" ToolTip="{Binding Folder}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="9,0,7,0">
                    <CheckBox Content="包含子文件夹" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,0,8" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCommand}" Content="选择文件夹" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding AddFilesCommand}"
                        Content="选择文件" VerticalAlignment="Bottom" Margin="0,0,7,0" />
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"
                        Content="只读扫描" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,5">
            <TextBlock Text="找到的表格" FontSize="10.5" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SummaryText}" FontSize="9" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Right" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource PreviewDataGrid}" ItemsSource="{Binding Files}" Margin="6,0,6,0">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="选" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="42" />
                    <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="240" />
                    <DataGridTextColumn Header="格式" Binding="{Binding Extension}" Width="58" />
                    <DataGridTextColumn Header="行数" Binding="{Binding RowCount}" Width="62" />
                    <DataGridTextColumn Header="表头" Binding="{Binding HeaderText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,8,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="筛选（列号从 0 开始）" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="1,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="列号" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Grid.Column="2" Text="条件" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding FilterColumnText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="列号，留空不筛选" />
                        <ComboBox Grid.Column="2" Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding FilterModes}" ItemTemplate="{StaticResource DisplayNameOptionTemplate}"
                                  SelectedItem="{Binding SelectedFilterMode, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="筛选值" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" Margin="1,5,0,3" />
                    <TextBox Style="{StaticResource InputTextBox}"
                             Text="{Binding FilterValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="筛选值" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="排序与选列" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="1,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="排序列号" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Grid.Column="2" Text="只保留这些列" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding SortColumnText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="排序列号，留空不排序" />
                        <TextBox Grid.Column="2" Style="{StaticResource InputTextBox}"
                                 Text="{Binding KeepColumnsText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="只保留这些列，如 0,2,3" />
                    </Grid>
                    <WrapPanel Margin="0,6,0,0">
                        <CheckBox Content="按数值" IsChecked="{Binding SortNumeric}" Margin="0,0,14,0" />
                        <CheckBox Content="降序" IsChecked="{Binding SortDescending}" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="合并说明" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="勾选多个表格会按首个表头合并；列号都从 0 开始，留空表示不处理。输出为 UTF-8 BOM CSV。"
                               FontSize="9" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="14,8,14,4">
                    <TextBlock Text="结果预览" FontSize="10.5" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding SelectedFileText}" FontSize="9"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding PreviewRowCount, StringFormat='共 {0} 行'}" FontSize="9"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="1" Style="{StaticResource PreviewDataGrid}" ItemsSource="{Binding PreviewView}"
                          AutoGenerateColumns="True" Margin="6,0,6,6" />
            </Grid>
        </Border>

        <Grid Grid.Row="6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding PreviewCommand}"
                        Content="生成预览" Margin="0,0,7,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}"
                        Content="导出 CSV" />
            </StackPanel>
            <TextBlock Text="导出前会检查同名文件，不覆盖已有文件；输出可在回退中心删除。"
                       FontSize="9" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="7" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                Padding="12,8" Margin="0,8,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding BusyText}" FontSize="10" Foreground="{DynamicResource AccentInkBrush}" />
                <ProgressBar Height="4" IsIndeterminate="{Binding IsProgressIndeterminate}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
