<UserControl x:Class="LocalCraft.App.Views.EnvironmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EnvironmentViewModel}">
        <StackPanel Margin="0,0,8,0">
            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="离线自检" Style="{StaticResource PageTitle}" />
                        <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="6" Padding="8,3"
                                Margin="12,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="完全本机 · 无出站请求" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="如实列出运行环境、数据位置和本地引擎状态。这里不会发起任何联网检测。"
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"
                        Content="重新检测" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="版本" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding VersionText}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="运行时" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding RuntimeText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="运行模式" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="完全离线" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="当前内存" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding MemoryText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="运行环境" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="只读信息，来自当前进程。" FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,10" />
                        <ItemsControl ItemsSource="{Binding SystemInfo}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="9.5"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="9.5"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenDataFolderCommand}"
                                    Content="打开数据目录" Margin="0,0,7,0" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding OpenLogsFolderCommand}"
                                    Content="打开日志目录" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="本地引擎" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="外部引擎只检测本机是否可用，不下载、不联网。" FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,10" />
                        <ItemsControl ItemsSource="{Binding Engines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="9"
                                            Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" FontSize="9"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    CornerRadius="5" Padding="6,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Available}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="8.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Available}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="已实现能力" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="全部离线可用，不依赖云端服务。" FontSize="10"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,10" />
                    <ItemsControl ItemsSource="{Binding Capabilities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding}" FontSize="10" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
</UserControl>
