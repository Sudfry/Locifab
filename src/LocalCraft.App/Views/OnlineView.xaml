<UserControl x:Class="LocalCraft.App.Views.OnlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OnlineViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="在线功能" Style="{StaticResource PageTitle}" />
                <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="6" Padding="8,3"
                        Margin="12,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="固定离线" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessBrush}" />
                </Border>
            </StackPanel>
            <TextBlock Text="参考版提供的在线翻译、OCR 和更新检查需要出站连接；这里按最初约定保持关闭。"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SuccessSoftBrush}"
                BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1"
                CornerRadius="12" Padding="16,13" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource SuccessBrush}">
                    <TextBlock Text="✓" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="程序不会发起任何联网请求" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="重命名、转换、去重、摘要、导出、分类、文本替换、备份和监控全部在本机完成。"
                               FontSize="10" Foreground="{DynamicResource InkSoftBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenLinksCommand}" Content="查看常用外部链接"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="未启用的在线能力" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="这些能力不会出现在执行路径里，也不会保存接口密钥。"
                           FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,12" />
                <ItemsControl ItemsSource="{Binding Features}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="9"
                                    Padding="12,9" Margin="0,0,0,7">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" FontSize="9.5"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="{DynamicResource WarningSoftBrush}" CornerRadius="5" Padding="7,2">
                                        <TextBlock Text="{Binding Status}" FontSize="8.5"
                                                   Foreground="{DynamicResource WarningBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="如果你需要在线服务，可到「常用链接」里手动打开外部网站；是否上传文件由你决定。"
                           FontSize="9.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
