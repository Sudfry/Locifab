<UserControl x:Class="LocalCraft.App.Views.PipelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:PipelineViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="任务流水线" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                            Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="步骤可无限增加 · 可保存模板" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentInkBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="从左侧已有工具中选择步骤，逐步设置参数；保存为模板后可以一键重复运行。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}" Content="↩  回退中心"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="源文件夹" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseSourceCommand}" Content="选择" Margin="7,0,0,0" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="输出根目录" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseOutputCommand}" Content="选择" Margin="7,0,0,0" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="步骤设计器" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="按从上到下的顺序执行；修改类步骤在副本上运行。"
                                       FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBox Width="150" Style="{StaticResource InputComboBox}"
                                      ItemsSource="{Binding StepKinds}"
                                      SelectedItem="{Binding SelectedStepKind, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddStepCommand}"
                                    Content="＋ 添加步骤" Margin="7,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="9"
                                            Padding="11,9" Margin="0,0,0,7">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                                                               VerticalAlignment="Center" Margin="7,0,0,0" />
                                                    <TextBlock Text="{Binding Description}" FontSize="9"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource CompactButton}" Content="↑"
                                                            Command="{Binding MoveUpCommand}" FontSize="10" Width="26" />
                                                    <Button Style="{StaticResource CompactButton}" Content="↓"
                                                            Command="{Binding MoveDownCommand}" FontSize="10" Width="26" />
                                                    <Button Style="{StaticResource CompactButton}" Content="✕"
                                                            ToolTip="删除步骤"
                                                            Command="{Binding RemoveCommand}" FontSize="10" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6"
                                                    Padding="7,3" HorizontalAlignment="Left" Margin="0,7,0,0"
                                                    Visibility="{Binding HasTemplate, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding TemplateLabel}" FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentInkBrush}" />
                                            </Border>
                                            <StackPanel Visibility="{Binding ShowParameters, Converter={StaticResource BoolToVisibility}}">
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Visibility="{Binding ShowText1, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding Label1}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Text1, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Visibility="{Binding ShowText2, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding Label2}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Text2, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Visibility="{Binding ShowText3, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding Label3}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Text3, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="6" Visibility="{Binding ShowNumber1, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding Label4}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Number1, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <StackPanel Visibility="{Binding ShowNumber2, Converter={StaticResource BoolToVisibility}}"
                                                            Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label5}" VerticalAlignment="Center"
                                                               FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,0,7,0" />
                                                    <TextBox Width="72" Style="{StaticResource InputTextBox}"
                                                             Text="{Binding Number2, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0"
                                                            Visibility="{Binding ShowChoice, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="格式" VerticalAlignment="Center" FontSize="9"
                                                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,7,0" />
                                                    <ComboBox Width="110" Style="{StaticResource InputComboBox}"
                                                              ItemsSource="{Binding ChoiceOptions}"
                                                              SelectedItem="{Binding Choice, Mode=TwoWay}" />
                                                </StackPanel>
                                                <CheckBox Content="{Binding Bool1Label}" IsChecked="{Binding Bool1}"
                                                          VerticalAlignment="Center" Margin="14,0,0,0"
                                                          Visibility="{Binding ShowBool1, Converter={StaticResource BoolToVisibility}}" />
                                                <CheckBox Content="{Binding Bool2Label}" IsChecked="{Binding Bool2}"
                                                          VerticalAlignment="Center" Margin="14,0,0,0"
                                                          Visibility="{Binding ShowBool2, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="模板 / 预设" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="保存步骤顺序和每一步的参数。" FontSize="9"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,9" />
                    <ComboBox Style="{StaticResource InputComboBox}" ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="模板名称" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding SavePresetCommand}"
                                Content="保存" Margin="6,0,0,0" />
                    </Grid>
                    <Button Style="{StaticResource CompactButton}" Command="{Binding DeletePresetCommand}"
                            Content="✕ 删除模板" HorizontalAlignment="Left" Margin="0,6,0,0" ToolTip="删除当前模板" />
                    <TextBlock Text="模板只保存在本机，不联网。" FontSize="8.5"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="导入功能配置" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="把某个功能保存的配置直接变成流水线步骤。" FontSize="8.5"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,6" />
                            <ComboBox Style="{StaticResource InputComboBox}" ItemsSource="{Binding ImportToolGroups}"
                                      SelectedItem="{Binding SelectedImportTool, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Style="{StaticResource InputComboBox}" ItemsSource="{Binding ImportToolPresets}"
                                      SelectedItem="{Binding SelectedImportPreset, Mode=TwoWay}"
                                      Margin="0,6,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ImportPresetCommand}"
                                    Content="添加为步骤" Margin="0,6,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="16,12,16,7">
                    <TextBlock Text="执行预览" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SummaryText}" FontSize="9.5"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding PreviewSteps}" Margin="16,0,16,7">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="9.5" Foreground="{DynamicResource InkSoftBrush}" Margin="0,0,0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Grid.Row="2" Margin="16,2,16,12">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding PreviewCommand}"
                            Content="刷新预览" HorizontalAlignment="Left" Margin="0,0,7,0" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}"
                            Content="执行流水线" HorizontalAlignment="Left" Margin="100,0,0,0" />
                    <TextBlock Text="每一步独立记录；修改类步骤在 _pipeline-work 副本上执行。"
                               FontSize="9" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                Padding="12,8" Margin="0,10,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding BusyText}" FontSize="10" Foreground="{DynamicResource AccentInkBrush}" />
                <ProgressBar Height="4" Margin="0,7,0,0" IsIndeterminate="True" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" CornerRadius="10" Padding="13,10" Margin="0,10,0,0"
                infra:FadeSlide.IsEnabled="True"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding ResultTitle}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ResultMessage}" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource InkSoftBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
