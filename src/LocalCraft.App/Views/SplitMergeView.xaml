<UserControl x:Class="LocalCraft.App.Views.SplitMergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:services="clr-namespace:LocalCraft.App.Services"
             xmlns:controls="clr-namespace:LocalCraft.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SplitMergeViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="拆分与合并" Style="{StaticResource PageTitle}" />
                <TextBlock Text="大文件按大小/份数拆分，或把分片按顺序合并；原文件不删除。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}" Content="↩  回退中心" />
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="拆分文件" IsChecked="{Binding IsSplit}" Margin="0,0,18,0" />
                    <RadioButton Content="合并分片" IsChecked="{Binding IsMerge}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="源文件" Style="{StaticResource FieldLabel}" /><TextBox Style="{StaticResource InputTextBox}" Text="{Binding SourceFile, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseSourceCommand}" Content="选择"
                                Margin="7,0,0,0" VerticalAlignment="Bottom" />
                        <StackPanel Grid.Column="3"><TextBlock Text="输出文件夹" Style="{StaticResource FieldLabel}" /><controls:PathTextBox Text="{Binding OutputFolder, Mode=TwoWay}" /></StackPanel>
                        <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseOutputCommand}" Content="选择"
                                Margin="7,0,0,0" VerticalAlignment="Bottom" />
                    </Grid>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Content="按大小" IsChecked="{Binding SplitBySize}"
                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="76" Style="{StaticResource InputTextBox}"
                                     Text="{Binding SizeMb, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />
                            <TextBlock Text="MB / 片" VerticalAlignment="Center" Margin="6,0,14,0"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="9.5" />
                        </StackPanel>
                        <RadioButton Grid.Column="2" Content="按份数" IsChecked="{Binding SplitByParts}"
                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="70" Style="{StaticResource InputTextBox}"
                                     Text="{Binding Parts, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />
                            <TextBlock Text="份" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="9.5" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Visibility="{Binding IsMerge, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="分片文件夹" Style="{StaticResource FieldLabel}" /><controls:PathTextBox Text="{Binding MergeFolder, Mode=TwoWay}" /></StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseMergeFolderCommand}" Content="选择"
                                Margin="7,0,0,0" VerticalAlignment="Bottom" />
                        <StackPanel Grid.Column="3"><TextBlock Text="输出文件" Style="{StaticResource FieldLabel}" /><TextBox Style="{StaticResource InputTextBox}" Text="{Binding MergeOutput, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseMergeOutputCommand}" Content="选择"
                                Margin="7,0,0,0" VerticalAlignment="Bottom" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="分片匹配" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                        <TextBox Width="140" Style="{StaticResource InputTextBox}" Text="{Binding MergePattern, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding PreviewCommand}" Content="生成预览" HorizontalAlignment="Left" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Summary}" Margin="16,12,16,8" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
                <DataGrid Grid.Row="1" Style="{StaticResource PreviewDataGrid}" ItemsSource="{Binding Rows}" Margin="8,0,8,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="1.2*" />
                        <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="1.6*" />
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}" Content="执行" HorizontalAlignment="Left" Margin="16,10,0,12" />
            </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,10,0,0"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding ResultTitle}" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Text="{Binding ResultMessage}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
