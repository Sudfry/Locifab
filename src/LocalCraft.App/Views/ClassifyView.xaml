<UserControl x:Class="LocalCraft.App.Views.ClassifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ClassifyViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="扫描与分类" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                            Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MODULE 06" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="按类型、修改时间或名称只读扫描，先生成移动预览，再按规则整理；所有移动可一键回退。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}" Content="↩  回退中心"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,10"
                IsEnabled="{Binding IsIdle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="扫描文件夹" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkSoftBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Style="{StaticResource InputTextBox}"
                             AutomationProperties.Name="扫描文件夹路径"
                             Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ScanCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseCommand}" Content="浏览…" Margin="8,0,0,0" />
                    <Button Grid.Column="3" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanCommand}" Content="扫描预览"
                            MinWidth="100" MinHeight="38" Margin="8,0,0,0" />
                </Grid>

                <WrapPanel Margin="0,11,0,0">
                    <CheckBox Content="包含子文件夹" IsChecked="{Binding IncludeSubfolders}"
                              Margin="0,0,22,6" />
                    <TextBlock Text="分类方式" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,6" />
                    <ComboBox Style="{StaticResource InputComboBox}" Width="150" Height="32"
                              ItemsSource="{Binding Modes}" ItemTemplate="{StaticResource DisplayNameOptionTemplate}"
                              SelectedItem="{Binding SelectedMode, Mode=TwoWay}" Margin="0,0,18,6" />
                    <TextBlock Text="名称取前" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Style="{StaticResource InputTextBox}" Width="44" MinHeight="30"
                             Padding="7,4" Margin="0,0,6,6"
                             Text="{Binding NamePrefixLengthText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="个字符（仅名称分类使用）" FontSize="10"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                               Margin="0,0,0,6" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalCount}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text=" 个文件" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                <Border Width="1" Height="12" Background="{DynamicResource BorderStrongBrush}" Margin="14,0" />
                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text=" 将移动 " FontSize="11" Foreground="{DynamicResource InkSoftBrush}" />
                <TextBlock Text="{Binding SelectedCount}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource SuccessBrush}" />
                <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="15,0,0,0" />
                <TextBlock Text=" 冲突 " FontSize="11" Foreground="{DynamicResource InkSoftBrush}" />
                <TextBlock Text="{Binding ConflictCount}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource DangerBrush}" />
                <Ellipse Width="6" Height="6" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="15,0,0,0" />
                <TextBlock Text=" 已归类 " FontSize="11" Foreground="{DynamicResource InkSoftBrush}" />
                <TextBlock Text="{Binding UnchangedCount}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding PreviewHint}" FontSize="9.5"
                           Foreground="{DynamicResource MutedBrush}" Margin="18,0,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                    Command="{Binding ClearConflictsCommand}" Content="取消冲突项" FontSize="10.5" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="16,13,16,10">
                    <StackPanel>
                        <TextBlock Text="分类预览" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="源文件 → 目标分类文件夹；扫描与预览阶段不创建目录、不移动文件。"
                                   FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <TextBlock Text="只读预览" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </Grid>
                <Grid Grid.Row="1">
                    <DataGrid Style="{StaticResource PreviewDataGrid}" ItemsSource="{Binding PreviewRows}"
                              AutomationProperties.Name="分类预览表" IsEnabled="{Binding IsIdle}"
                              Visibility="{Binding HasPreviewRows, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="46" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanToggle}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="#" Width="40" Binding="{Binding IndexText}" CanUserSort="False" />
                            <DataGridTemplateColumn Header="文件" Width="1.35*" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SourcePath}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="目标分类" Width="130" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5"
                                                Padding="7,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="移动到" Width="1.5*" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TargetPath}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TargetPath}" FontSize="10.5"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="98" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Badge" Background="{DynamicResource NeutralBadgeBrush}"
                                                CornerRadius="5" Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock x:Name="Label" Text="{Binding StatusText}" FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StatusKey}" Value="ready">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKey}" Value="conflict">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKey}" Value="invalid">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="说明" Width="1.2*" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Note}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Note}" FontSize="10.5"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Background="{DynamicResource CardBrush}"
                            Visibility="{Binding HasPreviewRows, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="分" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="先扫描，再预览分类" FontSize="12.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Text="选择文件夹和分类方式，系统只读取文件信息并生成移动计划。"
                                       FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" CornerRadius="10" Padding="13,10" Margin="0,10,0,0"
                infra:FadeSlide.IsEnabled="True"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="#C9E4D6" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="#ECC9C1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ResultTitle}" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ResultMessage}" FontSize="10.5" Foreground="{DynamicResource InkSoftBrush}"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                        Command="{Binding OpenUndoCenterCommand}" Content="打开回退中心 →"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="移动由本地日志记录；回退会把文件放回原文件夹。"
                               FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding ExecuteHint}" FontSize="10"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,5,18,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ExecuteCommand}" Content="执行分类移动  →"
                        MinWidth="166" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,8,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Height="5" Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceMutedBrush}" BorderThickness="0" />
                <TextBlock Text="{Binding BusyText}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
