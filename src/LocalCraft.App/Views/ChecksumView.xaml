<UserControl x:Class="LocalCraft.App.Views.ChecksumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChecksumViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="校验与清单" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                            Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SHA-256 · 只读校验" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentInkBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="生成可复查的 SHA-256 清单，或者用清单验证文件是否缺失、是否被改动。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}" Content="↩  回退中心"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="处理方式" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource InputComboBox}"
                              ItemsSource="{Binding Modes}"
                              ItemTemplate="{StaticResource DisplayNameOptionTemplate}"
                              SelectedItem="{Binding SelectedMode, Mode=TwoWay}" />
                    <TextBlock Text="{Binding SelectedMode.Description}" FontSize="9"
                               Foreground="{DynamicResource MutedBrush}" Margin="1,5,0,0" />
                </StackPanel>
                <CheckBox Grid.Column="2" Content="包含子文件夹" IsChecked="{Binding IncludeSubfolders}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="校验根目录" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" ToolTip="{Binding Folder}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseFolderCommand}" Content="选择" Margin="7,0,0,0" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SHA-256 清单" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding ManifestPath, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" ToolTip="{Binding ManifestPath}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseManifestCommand}" Content="选择" Margin="7,0,0,0" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="16,12,16,8">
                    <StackPanel>
                        <TextBlock Text="校验结果" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryText}" FontSize="9.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="5" Padding="7,2" Margin="0,0,5,0">
                            <TextBlock Text="{Binding OkCount, StringFormat='一致 {0}'}" FontSize="8.5"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </Border>
                        <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="5" Padding="7,2" Margin="0,0,5,0">
                            <TextBlock Text="{Binding ChangedCount, StringFormat='变化 {0}'}" FontSize="8.5"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </Border>
                        <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="5" Padding="7,2">
                            <TextBlock Text="{Binding MissingCount, StringFormat='缺失 {0}'}" FontSize="8.5"
                                       Foreground="{DynamicResource DangerBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="1" Style="{StaticResource PreviewDataGrid}"
                          ItemsSource="{Binding Rows}" Margin="8,0,8,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="文件" Binding="{Binding RelativePath}" Width="*" />
                        <DataGridTextColumn Header="摘要片段" Binding="{Binding Hash}" Width="180" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="16,10,16,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"
                                Content="{Binding ScanLabel}" Margin="0,0,7,0" />
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding WriteCommand}"
                                Content="写出清单"
                                Visibility="{Binding IsGenerate, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="清单是标准文本格式：SHA-256 + 相对路径；不包含文件内容。"
                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                Padding="12,8" Margin="0,10,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding BusyText}" FontSize="10" Foreground="{DynamicResource AccentInkBrush}" />
                <ProgressBar Height="4" Margin="0,7,0,0" IsIndeterminate="{Binding IsProgressIndeterminate}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" CornerRadius="10" Padding="13,10" Margin="0,10,0,0"
                infra:FadeSlide.IsEnabled="True"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding ResultTitle}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ResultMessage}" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource InkSoftBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
