<UserControl x:Class="LocalCraft.App.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConvertViewModel}"
             AllowDrop="True"
             DragOver="Root_DragOver"
             Drop="Root_Drop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="批量格式转换" Style="{StaticResource PageTitle}" />
                <TextBlock Text="文档与图片批量转换。先预览输出路径，再执行；原文件保留，转换结果可一键回退。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}"
                    VerticalAlignment="Center"
                    Content="↩  回退中心" />
        </Grid>

        <!-- Setup -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,10"
                IsEnabled="{Binding IsIdle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Margin="10,0,12,0">
                    <TextBlock Text="{Binding ResultTitle}" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ResultMessage}"
                               FontSize="10.5"
                               Foreground="{DynamicResource InkSoftBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding OpenUndoCenterCommand}"
                        Content="打开回退中心 →"
                        FontSize="10.5"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>


        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddFilesCommand}" Content="添加文件" />
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding AddFolderCommand}" Content="添加文件夹" />
                <Button Grid.Column="4" Style="{StaticResource GhostButton}" Command="{Binding ClearQueueCommand}" Content="清空队列" />
                <CheckBox Grid.Column="6" Content="包含子文件夹" IsChecked="{Binding IncludeSubfolders}" VerticalAlignment="Center" />
                <Button Grid.Column="7" Style="{StaticResource GhostButton}" Command="{Binding BrowseOutputCommand}" Content="输出目录" />
            </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="目标格式" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource InputComboBox}" ItemsSource="{Binding TargetFormats}"
                              ItemTemplate="{StaticResource DisplayNameOptionTemplate}"
                              SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="输出目录" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshPreviewCommand}"
                        Content="只读预览" VerticalAlignment="Bottom" Margin="10,0,0,0" />
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0" MinHeight="180">
            <DataGrid Style="{StaticResource PreviewDataGrid}" ItemsSource="{Binding PreviewRows}" Margin="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding IndexText}" Width="45" />
                    <DataGridTextColumn Header="源文件" Binding="{Binding SourceName}" Width="*" />
                    <DataGridTextColumn Header="目标文件" Binding="{Binding TargetName}" Width="*" />
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <!-- Footer -->
        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="原文件保留 · 输出写入回退日志 · 不覆盖已有文件"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkSoftBrush}" />
                    <TextBlock Text="{Binding ExecuteHint}"
                               FontSize="10.5"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,5,18,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}"
                            Content="取消并清理"
                            Margin="0,0,8,0"
                            Visibility="{Binding IsBusyVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExecuteCommand}"
                            Content="开始转换  →"
                            MinWidth="154" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="0,8,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Height="5"
                             Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource SurfaceMutedBrush}"
                             BorderThickness="0" />
                <TextBlock Text="{Binding BusyText}"
                           FontSize="10"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
