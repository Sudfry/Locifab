<UserControl x:Class="LocalCraft.App.Views.ImageBatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ImageBatchViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="批量图片处理" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                            Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="缩放 · 压缩 · 旋转 · 水印" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentInkBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="用 Windows WIC 在本地批量处理图片；不覆盖源文件，输出可在回退中心删除。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}" Content="↩  回退中心"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="图片文件夹" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="只读扫描 JPG / PNG / BMP / GIF / TIFF / 系统支持的 HEIC/RAW。"
                               FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,6" />
                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" ToolTip="{Binding Folder}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="9,0,0,0">
                    <CheckBox Content="包含子文件夹" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,12,8" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddFilesCommand}"
                            Content="选择图片" Margin="0,0,7,0" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCommand}"
                            Content="选择文件夹" Margin="0,0,7,0" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"
                            Content="只读扫描并预览" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="尺寸与旋转" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ComboBox Style="{StaticResource InputComboBox}"
                              ItemsSource="{Binding ResizeModes}" ItemTemplate="{StaticResource DisplayNameOptionTemplate}"
                              SelectedItem="{Binding SelectedResizeMode, Mode=TwoWay}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding SizeValue, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="长边或宽度像素" IsEnabled="{Binding IsSizeEnabled}" />
                        <TextBox Grid.Column="2" Style="{StaticResource InputTextBox}"
                                 Text="{Binding Percent, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="百分比" IsEnabled="{Binding IsPercent}" />
                    </Grid>
                    <ComboBox Style="{StaticResource InputComboBox}" Margin="0,6,0,0"
                              ItemsSource="{Binding Rotations}" ItemTemplate="{StaticResource DisplayNameOptionTemplate}"
                              SelectedItem="{Binding SelectedRotation, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="输出格式与质量" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ComboBox Style="{StaticResource InputComboBox}"
                              ItemsSource="{Binding Formats}" ItemTemplate="{StaticResource DisplayNameOptionTemplate}"
                              SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" />
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="JPEG 质量" FontSize="9" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding JpegQualityLabel}" FontSize="9" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider Minimum="1" Maximum="100" Value="{Binding JpegQuality, Mode=TwoWay}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="输出与隐私" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <Grid Margin="1,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="文件名后缀" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Grid.Column="2" Text="输出文件夹" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="文件名后缀" />
                        <TextBox Grid.Column="2" Style="{StaticResource InputTextBox}"
                                 Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输出文件夹" />
                    </Grid>
                    <TextBlock Text="水印文字（留空不加）" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" Margin="1,5,0,3" />
                    <TextBox Style="{StaticResource InputTextBox}"
                             Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="水印文字，留空则不加" />
                    <TextBlock Text="WIC 输出默认不保留 EXIF 等元数据。" FontSize="8.5"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="16,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="输出预览" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryText}" FontSize="9.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceMutedBrush}"
                            CornerRadius="8" Padding="6" Margin="12,0,0,0">
                        <StackPanel>
                            <Image Source="{Binding SelectedItem.AdjustedPreview, ElementName=PreviewGrid}"
                                   MaxWidth="240" MaxHeight="150" Stretch="Uniform"
                                   HorizontalAlignment="Center" />
                            <TextBlock Text="选中行的处理后效果" FontSize="8.5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
                <DataGrid x:Name="PreviewGrid" Grid.Row="1" Style="{StaticResource PreviewDataGrid}"
                          ItemsSource="{Binding Items}" Margin="8,0,8,0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <Border Background="{DynamicResource CardBrush}" Padding="8" CornerRadius="8">
                                        <StackPanel MaxWidth="480">
                                            <Image Source="{Binding AdjustedPreview}" MaxWidth="460" MaxHeight="320"
                                                   Stretch="Uniform" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="10"
                                                       Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Dimensions}" FontSize="9"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                                            <TextBlock Text="调整后预览 · 目标尺寸与水印" FontSize="9"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" />
                                            <TextBlock Text="{Binding OutputPath}" FontSize="9"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="源图片" Binding="{Binding FileName}" Width="1.1*" />
                        <DataGridTextColumn Header="尺寸变化" Binding="{Binding Dimensions}" Width="1.2*" />
                        <DataGridTextColumn Header="输出" Binding="{Binding OutputPath}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="16,10,16,12">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}"
                            Content="执行图片处理" HorizontalAlignment="Left" />
                    <TextBlock Text="默认不覆盖源文件；同名输出自动加序号。"
                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                Padding="12,8" Margin="0,10,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding BusyText}" FontSize="10" Foreground="{DynamicResource AccentInkBrush}" />
                <ProgressBar Height="4" Margin="0,7,0,0" Minimum="0" Maximum="100"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" CornerRadius="10" Padding="13,10" Margin="0,10,0,0"
                infra:FadeSlide.IsEnabled="True"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding ResultTitle}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ResultMessage}" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource InkSoftBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
