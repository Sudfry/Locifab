<UserControl x:Class="LocalCraft.App.Views.PhotoDedupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:LocalCraft.App.Infrastructure"
             xmlns:vm="clr-namespace:LocalCraft.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PhotoDedupViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="相似照片" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                            Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="感知哈希 · 每组保留一张" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentInkBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="找出尺寸或压缩不同、画面相似的照片；把多余照片隔离，保留每组最大的一张。"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenUndoCenterCommand}" Content="↩  回退中心"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="图片文件夹" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="扫描只读；感知哈希只比较画面结构，不读取云端。" FontSize="9"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,6" />
                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" ToolTip="{Binding Folder}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="9,0,0,0">
                    <CheckBox Content="包含子文件夹" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,12,8" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCommand}"
                            Content="选择文件夹" Margin="0,0,7,0" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"
                            Content="扫描相似照片" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="相似度阈值" FontSize="10.5" FontWeight="SemiBold" />
                        <TextBlock Text="越接近 100% 越严格；90%–95% 适合找同图不同版本。"
                                   FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,4" />
                        <Slider Minimum="70" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding ThresholdPercent, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ThresholdLabel}" FontSize="18"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="隔离文件夹" FontSize="10.5" FontWeight="SemiBold" />
                    <TextBlock Text="选中的相似照片移动到这里，原文件夹保留每组一张。"
                               FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding QuarantineDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding QuarantineDirectory}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseQuarantineCommand}" Content="选择" Margin="7,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="16,12,16,8">
                    <StackPanel>
                        <TextBlock Text="相似组" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryText}" FontSize="9.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Text="{Binding ScannedCount, StringFormat='扫描 {0}'}" FontSize="9"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding GroupCount, StringFormat='相似组 {0}'}" FontSize="9"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding SelectedCountText}" FontSize="9"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="1" Style="{StaticResource PreviewDataGrid}"
                          ItemsSource="{Binding Rows}" Margin="8,0,8,0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="选" Width="44" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="组" Binding="{Binding GroupId}" Width="65" />
                        <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="*" />
                        <DataGridTextColumn Header="尺寸" Binding="{Binding Dimensions}" Width="100" />
                        <DataGridTextColumn Header="体积" Binding="{Binding SizeText}" Width="80" />
                        <DataGridTextColumn Header="相似度" Binding="{Binding SimilarityText}" Width="75" />
                        <DataGridTextColumn Header="角色" Binding="{Binding RoleText}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="16,10,16,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SelectAllCommand}"
                                Content="全选相似项" Margin="0,0,7,0" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ClearSelectionCommand}"
                                Content="清空选择" Margin="0,0,7,0" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}"
                                Content="隔离选中照片" />
                    </StackPanel>
                    <TextBlock Text="默认不勾选；确认后再移动。"
                               FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                Padding="12,8" Margin="0,10,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding BusyText}" FontSize="10" Foreground="{DynamicResource AccentInkBrush}" />
                <ProgressBar Height="4" Margin="0,7,0,0" Minimum="0" Maximum="100"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" CornerRadius="10" Padding="13,10" Margin="0,10,0,0"
                infra:FadeSlide.IsEnabled="True"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsSuccess}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding ResultTitle}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ResultMessage}" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource InkSoftBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
