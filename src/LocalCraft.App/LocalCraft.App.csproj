<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LocalCraft.App</RootNamespace>
    <AssemblyName>Locifab</AssemblyName>
    <ApplicationIcon>Assets\Locifab.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>LocalCraft.App.Program</StartupObject>
    <Version>11.0.1</Version>
    <AssemblyVersion>11.0.1.0</AssemblyVersion>
    <FileVersion>11.0.1.0</FileVersion>
    <AssemblyTitle>Locifab 本地文件工具</AssemblyTitle>
    <Description>完全离线的本地文件处理工具</Description>
    <Company>Sudfry</Company>
    <Authors>Sudfry</Authors>
    <Product>Locifab</Product>
    <Copyright>© 2026 Sudfry</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalCraft.Core\LocalCraft.Core.csproj" />
    <Reference Include="LocalCraft.Conversion">
      <HintPath>..\LocalCraft.Conversion\bin\Release\net8.0-windows\win-x64\LocalCraft.Conversion.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
